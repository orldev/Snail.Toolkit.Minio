<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <PackageId>Snail.Toolkit.Minio</PackageId>
        <PackageTags>minio;s3;object-storage;aws-s3;streaming;presigned-url;resilience;dependency-injection</PackageTags>
        <Title>Snail.Toolkit.Minio</Title>
        <Authors>Toolkit</Authors>
        <Description>Object storage for .NET over MinIO and any S3-compatible server. Inject IObjectStorage and upload, download, stream, list and share objects: failures come back as data instead of exceptions, reads stream instead of buffering, ranged reads work, and retries, a circuit breaker, tracing and logging are built in. Several servers side by side through keyed registration, settings validated at startup.</Description>
        <RepositoryUrl>https://github.com/orldev/Snail.Toolkit.Minio</RepositoryUrl>
        <Copyright>Toolkit, 2026</Copyright>
        <PackageProjectUrl>https://github.com/orldev/Snail.Toolkit.Minio</PackageProjectUrl>
        <RepositoryType>GitHub</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
        <InternalsVisibleTo Include="Snail.Toolkit.Minio.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
        <PackageReference Include="Minio" Version="7.0.0" />
    </ItemGroup>
</Project>
