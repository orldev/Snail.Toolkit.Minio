<Project Sdk="Snail.Sdk.Library">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- The audit (Toolkit/.audit/B.md, Minio) published it with Native AOT: the client warns and then reads wrong. -->
        <SnailNotNativeBecause>Minio 7.0.0 is not trim- or AOT-safe: a native publish warns IL2026, IL3050 and IL2075 inside Minio.dll (its XmlSerializer use), and a bucket's lifecycle then reads as no rules and is reported as a success.</SnailNotNativeBecause>
        <PackageId>Snail.Toolkit.Minio</PackageId>
        <PackageTags>minio;s3;object-storage;aws-s3;streaming;presigned-url;resilience;dependency-injection</PackageTags>
        <Title>Snail.Toolkit.Minio</Title>
        <Authors>Toolkit</Authors>
        <Description>Object storage for .NET over MinIO and any S3-compatible server. Inject IObjectStorage and upload, download, stream, list, copy and share objects, and let a bucket expire what it holds: failures come back as data instead of exceptions, reads stream instead of buffering, ranged reads work, and retries, a circuit breaker, tracing and logging are built in. Several servers side by side through keyed registration, settings validated at startup.</Description>
        <RepositoryUrl>https://github.com/orldev/Snail.Toolkit.Minio</RepositoryUrl>
        <Copyright>Toolkit, 2026</Copyright>
        <PackageProjectUrl>https://github.com/orldev/Snail.Toolkit.Minio</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
        <InternalsVisibleTo Include="Snail.Toolkit.Minio.Tests"/>
        <InternalsVisibleTo Include="Snail.Toolkit.Minio.Benchmarks"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Minio" />
    </ItemGroup>
</Project>
